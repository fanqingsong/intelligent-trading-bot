# syntax=swr.cn-north-4.myhuaweicloud.com/ddn-k8s/docker.io/docker/dockerfile:1
FROM swr.cn-north-4.myhuaweicloud.com/ddn-k8s/docker.io/python:3.12-slim

WORKDIR /app

# Debian apt mirror (Aliyun)
RUN sed -i 's|deb.debian.org|mirrors.aliyun.com|g' /etc/apt/sources.list.d/debian.sources \
    && sed -i 's|security.debian.org|mirrors.aliyun.com|g' /etc/apt/sources.list.d/debian.sources \
    && apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# Huawei PyPI: faster for large wheels in CN than Aliyun.
ENV PIP_INDEX_URL=https://repo.huaweicloud.com/repository/pypi/simple
ENV PIP_TRUSTED_HOST=repo.huaweicloud.com
ENV PIP_DEFAULT_TIMEOUT=120

# Install deps before copying app source so code edits do not bust this cache.
COPY requirements-services.txt requirements.txt ./
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install -r requirements-services.txt \
    && pip install \
        click tqdm numpy pandas pyarrow apscheduler akshare

COPY pyproject.toml README.md LICENSE ./
COPY shared ./shared
COPY backend ./backend
COPY kedro_pipeline ./kedro_pipeline
# Metadata only; site-packages deps already installed above.
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install -e . --no-deps

ENV PYTHONUNBUFFERED=1
ENV PYTHONPATH=/app

EXPOSE 8000

CMD ["uvicorn", "backend.main:app", "--host", "0.0.0.0", "--port", "8000", "--reload", "--reload-dir", "/app"]
